+    if(mt_sample_queue_pop_span(&d->queue,b,d->tx_blocks)!=MT_SAMPLE_QUEUE_OK)return 0;
+    d->prefix_crc_state=crc;d->prefix_end=d->tx_first_index+d->tx_count;
+    d->last_data_sequence=d->tx_sequence;return 1;
+}
