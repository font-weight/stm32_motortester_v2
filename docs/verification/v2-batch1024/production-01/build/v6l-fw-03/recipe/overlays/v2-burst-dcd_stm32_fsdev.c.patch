+#endif
     }
   }
 
@@ -565,6 +610,20 @@
   if (mt_ctr_serviced) {
     mt_ctr_deferred = true;
     FSDEV_REG->CNTR &= (fsdev_bus_t)~U_CNTR_CTRM;
+    /* Only an intermediate data-IN packet may spend the remaining grant.
