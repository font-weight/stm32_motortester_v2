-// Foreground only, under the same save/restore guard as the DCD ISR. The owner
-// must service ADC/TIME and empty queued USB work before granting a new quantum.
-// This never clears pending CTR or fabricates completion/epoch evidence.
-bool mt_usb_fsdev_ctr_rearm(void) {
-  if ((FSDEV_REG->ISTR & (U_ISTR_RESET | U_ISTR_PMAOVR | U_ISTR_SUSP)) ||
