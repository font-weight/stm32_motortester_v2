# Verification receipts and CSV sidecars must keep their recorded SHA-256 bytes.
docs/verification/v2-windows/** -text
docs/verification/v2-device/** -text
docs/verification/v2-close/** -text
docs/verification/v2-stream/** -text whitespace=cr-at-eol
docs/verification/v2-stream-picker/** -text whitespace=cr-at-eol
docs/verification/v2-200ksps/** -text whitespace=cr-at-eol
docs/verification/v2-200ksps-board/** -text whitespace=cr-at-eol
# Preserve the CLI's exact trailing spaces/newlines and raw ADC bytes.
docs/verification/v2-200ksps-board/attempt-01/*.txt -whitespace
docs/verification/v2-200ksps-board/**/*.u16le binary
docs/verification/v2-200ksps-usb/** -text whitespace=cr-at-eol
docs/verification/v2-200ksps-usb/firmware/*.map -whitespace
docs/verification/v2-200ksps-board2/** -text whitespace=cr-at-eol
docs/verification/v2-200ksps-board2/**/*.u16le binary
docs/verification/v2-200ksps-board2/attempt-02/*.txt -whitespace
# V2 firmware overlays are applied only after an exact byte-hash check.
firmware/v2-stream/overlays/*.patch -text whitespace=-blank-at-eol,-blank-at-eof
firmware/v2-stream/overlays/mt_v2_crc32.h -text
